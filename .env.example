# Firebase project config (Firebase Console > Project settings > Your apps > Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: Google Maps API key for Android map rendering (Google Cloud Console > APIs & Services > Credentials)
EXPO_PUBLIC_ANDROID_GOOGLE_MAPS_API_KEY=

# Expo project ID (from `eas init` / expo.dev project settings) — needed for push notification tokens
EXPO_PUBLIC_EAS_PROJECT_ID=
